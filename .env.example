# ==============================================================================
# PLANOVA ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env.local and populate your credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HUGGING FACE GENERATIVE AI (Primary AI Engine)
# Obtain your free Access Token from: https://huggingface.co/settings/tokens (Read role)
# ------------------------------------------------------------------------------
HUGGINGFACE_API_KEY=hf_your_token_here
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Alternative high-performance models:
# HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct
# HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# (Optional Free Fallbacks: Groq or Google Gemini)
# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Free Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTH (Required for production database & RLS)
# Obtain from your Supabase Project Settings -> API: https://app.supabase.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
