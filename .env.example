# ==============================================================================
# PLANOVA ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env.local and populate your credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GROQ GENERATIVE AI (Required for production AI features)
# Obtain your fast API key from: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTH (Required for production database & RLS)
# Obtain from your Supabase Project Settings -> API: https://app.supabase.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
